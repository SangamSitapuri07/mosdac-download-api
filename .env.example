# ---- MOSDAC credentials (ASLI values yahan daalo, aur is file ko KABHI commit mat karo) ----
# Copy:  cp .env.example .env        (ya Windows: copy .env.example .env)
MOSDAC_USER="tumhara_mosdac_username"
MOSDAC_PASS="tumhara_mosdac_password"

# ---- Download settings (optional - chaho to change karo) ----
MOSDAC_DATASET="3RIMG_L2B_SST"
MOSDAC_START="2026-08-29"
MOSDAC_END="2026-09-01"
MOSDAC_COUNT="2"
MOSDAC_DOWNLOAD_PATH="./data"
MOSDAC_ORGANIZE="true"      # true/false - date-wise folders
MOSDAC_SKIP_PROMPT="false"  # true = bina Y/N poochhe download (background)
